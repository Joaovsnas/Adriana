<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="408.0" prefWidth="517.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.e2_.AnimalController">
    <!-- Tabela de Animais -->
    <TableView fx:id="tabelaAnimais" layoutX="276.0" layoutY="19.0" prefHeight="163.0" prefWidth="217.0">
        <columns>
            <TableColumn fx:id="colunaNome" prefWidth="67.199951171875" text="Nome" />
            <TableColumn fx:id="colunaEspecie" text="Espécie" />
            <TableColumn fx:id="colunaIdade" prefWidth="69.60003051757812" text="Idade" />
        </columns>
    </TableView>

    <!-- Campos para Preencher os Dados do Animal -->
    <Label layoutX="14.0" layoutY="23.0" text="Nome" />
    <TextField fx:id="campoNome" layoutX="62.0" layoutY="19.0" />

    <Label layoutX="25.0" layoutY="63.0" text="Espécie" />
    <TextField fx:id="campoEspecie" layoutX="62.0" layoutY="59.0" />

    <Label layoutX="24.0" layoutY="103.0" text="Idade" />
    <TextField fx:id="campoIdade" layoutX="62.0" layoutY="99.0" />

    <!-- Botões para Interagir -->
    <Button fx:id="btnAdicionarTabela" layoutX="44.0" layoutY="145.0" onAction="#handleAdicionarTabela" text="ADICIONAR" />
    <Button fx:id="btnEliminar" layoutX="141.0" layoutY="145.0" onAction="#handleEliminarTabela" text="REMOVER" />

    <!-- Mensagem de Execução -->
    <Label fx:id="mensagemExecucao" layoutX="44.0" layoutY="188.0" text="" />
</AnchorPane>

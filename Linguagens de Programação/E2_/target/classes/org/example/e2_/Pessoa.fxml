<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="408.0" prefWidth="517.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.e2_.PessoaController">
    <!-- Tabela de Pessoas -->
    <TableView fx:id="tabelaPessoas" layoutX="276.0" layoutY="19.0" prefHeight="163.0" prefWidth="217.0">
        <columns>
            <TableColumn fx:id="colunaNome" prefWidth="67.199951171875" text="Nome" />
            <TableColumn fx:id="colunaIdade" text="Idade" />
            <TableColumn fx:id="colunaEndereco" prefWidth="69.60003051757812" text="Endereço" />
        </columns>
    </TableView>

    <!-- Campos para Preencher os Dados da Pessoa -->
    <Label layoutX="14.0" layoutY="23.0" text="Nome" />
    <TextField fx:id="campoNome" layoutX="62.0" layoutY="19.0" />

    <Label layoutX="25.0" layoutY="63.0" text="Idade" />
    <TextField fx:id="campoIdade" layoutX="62.0" layoutY="59.0" />

    <Label layoutX="24.0" layoutY="103.0" text="Endereço" />
    <TextField fx:id="campoEndereco" layoutX="62.0" layoutY="99.0" />

    <!-- Botões para Interagir -->
    <Button fx:id="btnAdicionarTabela" text="Adicionar" layoutX="62.0" layoutY="139.0" onAction="#handleAdicionarTabela" />
    <Button fx:id="btnEliminar" text="Eliminar" layoutX="62.0" layoutY="179.0" onAction="#handleEliminarTabela" />

    <!-- Mensagem de Execução -->
    <Label fx:id="mensagemExecucao" layoutX="62.0" layoutY="219.0" />
</AnchorPane>

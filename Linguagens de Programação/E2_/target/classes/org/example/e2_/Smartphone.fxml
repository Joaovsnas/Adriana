<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="408.0" prefWidth="517.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.e2_.SmartphoneController">
    <!-- Tabela de Smartphones -->
    <TableView fx:id="tabelaSmartphones" layoutX="276.0" layoutY="19.0" prefHeight="163.0" prefWidth="217.0">
        <columns>
            <TableColumn fx:id="colunaMarca" prefWidth="67.199951171875" text="Marca" />
            <TableColumn fx:id="colunaModelo" text="Modelo" />
            <TableColumn fx:id="colunaAno" prefWidth="69.60003051757812" text="Ano" />
        </columns>
    </TableView>

    <!-- Campos para Preencher os Dados do Smartphone -->
    <Label layoutX="14.0" layoutY="23.0" text="Marca" />
    <TextField fx:id="campoMarca" layoutX="62.0" layoutY="19.0" />

    <Label layoutX="25.0" layoutY="63.0" text="Modelo" />
    <TextField fx:id="campoModelo" layoutX="62.0" layoutY="59.0" />

    <Label layoutX="24.0" layoutY="103.0" text="Ano" />
    <TextField fx:id="campoAno" layoutX="62.0" layoutY="99.0" />

    <!-- Botões para Adicionar e Limpar a Tabela -->
    <Button fx:id="btnAdicionarTabela" layoutX="62.0" layoutY="139.0" text="Adicionar" onAction="#handleAdicionarTabela" />
    <Button fx:id="btnEliminar" layoutX="62.0" layoutY="179.0" text="Eliminar" onAction="#handleEliminarTabela" />

    <!-- Mensagem de Execução -->
    <Label fx:id="mensagemExecucao" layoutX="62.0" layoutY="219.0" />
</AnchorPane>
